# Copy to .env and fill in. Never commit .env.
# Supabase dashboard → Project Settings → API Keys.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Secret key (sb_secret_...). Server-only: bypasses Row Level Security.
SUPABASE_SECRET_KEY=

KITCHEN_CODE=kitchen-001
ENV_DEVICE_ID=vk-env-01
CAMERA_DEVICE_ID=vk-cam-01
MODEL_VERSION=simulator-v1
# Storage cadences: ESP32 message period, AI detection period, and how often a score is stored.
SENSOR_INTERVAL_S=30
AI_INTERVAL_S=15
SCORE_PERSIST_S=60
LOG_LEVEL=INFO

# --- Camera process (edge-service vision; needs: uv sync --extra vision) ---------
# The camera process never uses the Supabase key; it only publishes to MQTT.
# Its broker password is written here by infrastructure/mosquitto/add-device.sh vk-cam-01
VISION_MQTT_PASSWORD=
# Model (not in git): CoreML package from the training notebook, or .pt weights.
VISION_MODEL=models/ppe_yolo26n_best.mlpackage
# 0 = built-in webcam (any number = camera index), rtsp = VK_RTSP_URL, or a video file path.
VISION_SOURCE=0
# RTSP camera, e.g. rtsp://user:pass@192.168.1.50:554/stream1 (secret: never logged or published)
VK_RTSP_URL=
VISION_FPS=5
VISION_WINDOW_S=5
VISION_CONF=0.4
VISION_MIN_FRAMES=3
# Worker region "x,y,w,h" as fractions of the frame (empty = full frame). Find it with --preview.
VISION_ROI=
