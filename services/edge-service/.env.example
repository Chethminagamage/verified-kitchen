# Copy to .env and fill in. Never commit .env.
# Supabase dashboard → Project Settings → API Keys.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Secret key (sb_secret_...). Server-only: bypasses Row Level Security.
SUPABASE_SECRET_KEY=

KITCHEN_CODE=kitchen-001
ENV_DEVICE_ID=vk-env-01
CAMERA_DEVICE_ID=vk-cam-01
MODEL_VERSION=simulator-v1
SCORE_WINDOW_S=60
# Storage cadences: ESP32 message period, AI detection period, and how often a score is stored.
SENSOR_INTERVAL_S=30
AI_INTERVAL_S=15
SCORE_PERSIST_S=60
LOG_LEVEL=INFO
