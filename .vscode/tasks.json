  "tasks": [
    {
      "label": "Verified Kitchen: start",
      "type": "shell",
      "command": "./dev.sh",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Verified Kitchen: start (sensors only, no website)",
      "type": "shell",
      "command": "./dev.sh --no-web",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    }
  ]
}
